# Copy this file to .env and add local configuration values as needed.
# Never commit .env or credentials.

# Personal Access Token for the Datawrapper API.
# Get one from: https://app.datawrapper.de/account/api-tokens
DATAWRAPPER_ACCESS_TOKEN=

# Optional: free-text guidance passed to MCP clients as the server's
# "instructions", which some clients fold into the model's context (e.g.
# house style rules, required fields, naming conventions).
DATAWRAPPER_MCP_INSTRUCTIONS=
